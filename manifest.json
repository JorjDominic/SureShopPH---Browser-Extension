{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "SureShopPH - Online Shopping Risk Detection and Analysis",
  "short_name": "SureShopPH",
  "description": "Helps Filipino online shoppers identify potential risks in online shopping listings on Shopee, Lazada, and Facebook Marketplace. Analyzes product listings for observable risk signals when you click Scan. Data is processed by the SureShopPH service. Privacy policy available at sureshopph.site/privacy-policy",
  "version": "0.3.0",
  "minimum_chrome_version": "114",
  "homepage_url": "https://www.sureshopph.site",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open SureShop side panel"
    }
 
  },
  "side_panel": {
    "default_path": "src/popup/popup.html"
  },
  "host_permissions": [
    "https://*.shopee.ph/*",
    "https://*.lazada.com.ph/*",
    "https://*.facebook.com/marketplace/*",
    "https://sureshopph-backend-layer-production.up.railway.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.shopee.ph/*"],
      "js": ["src/config.js", "src/shared/storage.js", "src/content/content_shopee.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.lazada.com.ph/*"],
      "js": ["src/config.js", "src/shared/storage.js", "src/content/content_lazada.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://*.facebook.com/marketplace/*"],
      "js": ["src/config.js", "src/shared/storage.js", "src/content/content_facebook.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "SureShop - Scan for scams",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [{
    "resources": [
      "assets/fonts/fa/fa-solid-combined.css",
      "assets/fonts/fa/webfonts/fa-solid-900.woff2",
      "assets/fonts/fa/webfonts/fa-solid-900.ttf",
      "assets/fonts/poppins/poppins.css",
      "assets/fonts/poppins/poppins-300.woff2",
      "assets/fonts/poppins/poppins-400.woff2",
      "assets/fonts/poppins/poppins-500.woff2",
      "assets/fonts/poppins/poppins-600.woff2",
      "assets/fonts/poppins/poppins-700.woff2",
      "assets/fonts/poppins/poppins-800.woff2",
      "src/onboarding/onboarding.html",
      "src/shared/storage.js"
    ],
    "matches": [
      "https://*.shopee.ph/*",
      "https://*.lazada.com.ph/*",
      "https://*.facebook.com/marketplace/*"
    ]
  }]
}
